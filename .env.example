# The JSON-RPC endpoint for one Bitcoin Core-compatible node.
COREWARDEN_RPC_URL=http://127.0.0.1:8337
COREWARDEN_RPC_USER=rpc-user
COREWARDEN_RPC_PASSWORD=replace-me
COREWARDEN_RPC_TIMEOUT_SECONDS=10

# Amazon Bedrock model used by Strands. AWS credentials follow boto3's normal
# credential chain and are intentionally not CoreWarden-specific secrets.
COREWARDEN_MODEL_ID=global.anthropic.claude-sonnet-4-6
AWS_REGION=us-west-2

# Optional BYO credential used only with: corewarden --provider openai
# CoreWarden does not store this key. Use a project-scoped restricted key.
OPENAI_API_KEY=your-project-key-here

# Optional Milestone 2 evidence capture. The file contains redacted node and
# peer observations and should still be treated as operationally sensitive.
COREWARDEN_DIAGNOSTIC_MODE=false
COREWARDEN_EVIDENCE_PATH=corewarden-evidence.json
